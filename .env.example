# Copy to .env.local and fill in. Never commit real keys.
# Without these the app runs in demo mode: practice stays unlocked and emails
# are logged to the server instead of being sent.

# ---------------------------------------------------------------- app
# Used to build Stripe redirect URLs and links inside emails.
NEXT_PUBLIC_APP_URL=http://localhost:3080

# ------------------------------------------------------------- storage
# REQUIRED IN PRODUCTION. Vercel's filesystem is read-only, so without these
# nothing can be saved. Locally they can be left blank and the app falls back
# to JSON files under data/.
# Easiest setup: Vercel dashboard > Storage > Upstash Redis, which injects both.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------- stripe
# Prefer a RESTRICTED key (rk_...) over a secret key (sk_...).
# It needs: write on Checkout Sessions, Customers, Billing Portal Sessions
# and Subscriptions; read on Prices and Invoices.
STRIPE_SECRET_KEY=

# From `stripe listen` locally, or the endpoint's signing secret in the
# Dashboard. Without it the webhook route refuses every request.
STRIPE_WEBHOOK_SECRET=

# Two recurring monthly prices on one product ("PEDMAS Family"):
#   first child      $11.99 / month
#   additional child  $5.99 / month
STRIPE_PRICE_FIRST_CHILD=
STRIPE_PRICE_ADDITIONAL_CHILD=

# -------------------------------------------------------------- email
# https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sending domain, e.g. "PEDMAS <hello@pedmas.com>"
EMAIL_FROM=

# ---------------------------------------------------------------- cron
# Bearer token for POST /api/cron/weekly-progress. Unset = endpoint disabled.
CRON_SECRET=

# --------------------------------------------------------------- admin
# Seeded on first run. Set both before deploying — the fallbacks are public.
PEDMAS_ADMIN_EMAIL=
PEDMAS_ADMIN_PASSWORD=
